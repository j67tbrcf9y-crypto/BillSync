const { useState, useEffect, useRef, useCallback } = React;

// ---------------------------------------------------------------------------
// window.storage shim — same get/set signature the app already calls,
// backed by this browser's own localStorage instead of Claude's storage.
// The `shared` argument is accepted for compatibility but unused: on a
// single device there's only one local visitor, so personal vs. shared
// isn't a meaningful distinction here.
// ---------------------------------------------------------------------------
(function () {
  const PREFIX = "billsync:";
  window.storage = {
    get(key) {
      return new Promise((resolve, reject) => {
        try {
          const value = localStorage.getItem(PREFIX + key);
          if (value === null) {
            reject(new Error("not found"));
            return;
          }
          resolve({ key, value });
        } catch (e) {
          reject(e);
        }
      });
    },
    set(key, value) {
      return new Promise((resolve, reject) => {
        try {
          localStorage.setItem(PREFIX + key, value);
          resolve({ key, value });
        } catch (e) {
          reject(e);
        }
      });
    },
    delete(key) {
      return new Promise((resolve) => {
        localStorage.removeItem(PREFIX + key);
        resolve({ key, deleted: true });
      });
    },
    list(prefix) {
      return new Promise((resolve) => {
        const keys = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.startsWith(PREFIX)) {
            const bare = k.slice(PREFIX.length);
            if (!prefix || bare.startsWith(prefix)) keys.push(bare);
          }
        }
        resolve({ keys });
      });
    },
  };
})();

