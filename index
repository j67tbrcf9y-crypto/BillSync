          const status = b.status || "due";
          const paid = status === "paid";
          return (
            <SwipeRow key={b.id} onDelete={() => remove(b.id)}>
              <div
                style={{
                  background: "var(--card)",
                  border: "1px solid var(--border)",
                  borderRadius: 3,
                  padding: "14px",
                  display: "flex",
