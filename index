        <select value={frequency} onChange={(e) => setFrequency(e.target.value)} style={inputStyle}>
          {FREQUENCIES.map((f) => (
            <option key={f.id} value={f.id}>{f.label}</option>
          ))}
        </select>
      </Field>
      <Toggle
        checked={recurring}
        onChange={setRecurring}
        label="Repeats every month"
        hint="It'll be waiting for you next month — no need to add it again."
      />
      <ModalActions onCancel={onCancel} onSave={save} disabled={!name.trim() || !amount} />
    </Modal>
  );
}

// ---------------------------------------------------------------------------
// Goals view
// ---------------------------------------------------------------------------

function GoalsView({ data, setData, showToast }) {
  const [form, setForm] = useState(null); // goal add/edit modal
  const [contributeFor, setContributeFor] = useState(null); // goal id for add/take-out modal

  const goals = data.goals || [];
  const totalSaved = goals.reduce((s, g) => s + (Number(g.saved) || 0), 0);

  const upsert = (goal) => {
    setData((d) => {
      const exists = d.goals.some((g) => g.id === goal.id);
      const goalsList = exists ? d.goals.map((g) => (g.id === goal.id ? goal : g)) : [...d.goals, goal];
      return { ...d, goals: goalsList };
    });
    setForm(null);
    showToast(goal.name ? `Saved "${goal.name}"` : "Saved");
  };

  const remove = (id) => {
    setData((d) => ({ ...d, goals: d.goals.filter((g) => g.id !== id) }));
    showToast("Goal removed");
  };

  const contribute = (id, delta) => {
    setData((d) => ({
      ...d,
      goals: d.goals.map((g) => (g.id === id ? { ...g, saved: Math.max(0, (Number(g.saved) || 0) + delta) } : g)),
    }));
    setContributeFor(null);
  };

  const activeGoal = contributeFor ? goals.find((g) => g.id === contributeFor) : null;

  return (
    <div style={{ paddingTop: 18 }}>
      <div style={{ fontFamily: "'Fraunces', serif", fontSize: 19, fontWeight: 600 }}>Goals</div>
      <div style={{ fontSize: 12.5, color: "var(--ink-soft)", marginTop: 4 }}>Save up for something you want.</div>

      {goals.length > 0 && (
        <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: 3, padding: "14px 16px", marginTop: 14, display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
          <span style={{ fontSize: 13.5, fontFamily: "'Fraunces', serif" }}>Total saved</span>
          <span style={{ fontFamily: "'IBM Plex Mono', monospace", fontSize: 18, fontWeight: 700, color: "var(--accent)" }}>{money(totalSaved)}</span>
        </div>
      )}

      <div style={{ display: "flex", flexDirection: "column", gap: 8, marginTop: 14 }}>
        {goals.length === 0 && <EmptyNote>No goals yet. Add something you're saving up for — headphones, a bike, whatever it is.</EmptyNote>}
        {goals.map((g) => {
          const pct = g.target > 0 ? Math.min(100, (g.saved / g.target) * 100) : 0;
          const reached = g.target > 0 && g.saved >= g.target;
          return (
            <SwipeRow key={g.id} onDelete={() => remove(g.id)}>
              <div style={{ background: "var(--card)", border: "1px solid var(--border)", borderRadius: 3, padding: "14px" }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 10 }}>
                  <div style={{ flex: 1, minWidth: 0 }} onClick={() => setForm(g)}>
                    <div style={{ fontWeight: 600, fontSize: 14.5 }}>{g.name || "Untitled goal"}</div>
                    <div style={{ fontFamily: "'IBM Plex Mono', monospace", fontSize: 11.5, color: "var(--muted)", marginTop: 2 }}>
                      {money(g.saved)} of {money(g.target)}
                    </div>
                  </div>
                  {reached ? (
                    <span style={{ fontSize: 10.5, fontFamily: "'IBM Plex Mono', monospace", fontWeight: 600, color: "var(--on-accent)", background: "var(--accent)", borderRadius: 20, padding: "5px 10px", flexShrink: 0 }}>
                      Reached
                    </span>
                  ) : (
                    <button
                      onClick={() => setContributeFor(g.id)}
                      style={{ background: "var(--accent)", color: "var(--on-accent)", border: "none", borderRadius: 20, padding: "6px 12px", fontSize: 11, fontFamily: "'IBM Plex Mono', monospace", fontWeight: 600, flexShrink: 0, display: "flex", alignItems: "center", gap: 4 }}
                    >
                      <Plus size={12} /> Add
                    </button>
                  )}
                </div>
                <div style={{ height: 6, borderRadius: 3, background: "var(--track)", overflow: "hidden", marginTop: 10 }}>
                  <div style={{ width: `${pct}%`, height: "100%", background: "var(--accent)", transition: "width 0.4s ease" }} />
                </div>
              </div>
            </SwipeRow>
          );
        })}
      </div>

      <AddButton onClick={() => setForm({})} label="Add goal" />

      {form !== null && <GoalForm initial={form} onCancel={() => setForm(null)} onSave={upsert} />}
      {activeGoal && (
        <ContributionModal
          goal={activeGoal}
          onCancel={() => setContributeFor(null)}
          onAdd={(amt) => contribute(activeGoal.id, amt)}
          onTakeOut={(amt) => contribute(activeGoal.id, -amt)}
        />
      )}
    </div>
  );
}

function GoalForm({ initial, onCancel, onSave }) {
  const isNew = !initial.id;
  const [name, setName] = useState(initial.name || "");
  const [target, setTarget] = useState(initial.target ?? "");

  const save = () => {
    if (!name.trim() || !target) return;
    onSave({
      id: initial.id || uid(),
      name: name.trim(),
      target: Number(target),
      saved: initial.saved || 0,
    });
  };

  return (
    <Modal title={isNew ? "Add goal" : "Edit goal"} onClose={onCancel}>
      <Field label="What are you saving for?">
        <input autoFocus value={name} onChange={(e) => setName(e.target.value)} placeholder="Headphones, a bike, new shoes…" style={inputStyle} />
      </Field>
      <Field label="How much does it cost?">
        <input type="number" inputMode="decimal" value={target} onChange={(e) => setTarget(e.target.value)} placeholder="0.00" style={inputStyle} />
      </Field>
      <ModalActions onCancel={onCancel} onSave={save} disabled={!name.trim() || !target} />
    </Modal>
  );
}

function ContributionModal({ goal, onCancel, onAdd, onTakeOut }) {
  const [mode, setMode] = useState("add"); // add | take
  const [amount, setAmount] = useState("");

  const save = () => {
    const amt = Number(amount);
    if (!amt) return;
    if (mode === "add") onAdd(amt);
    else onTakeOut(amt);
  };

  return (
    <Modal title={goal.name || "Update savings"} onClose={onCancel}>
      <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
        <button
          onClick={() => setMode("add")}
          style={{
            flex: 1,
            padding: "10px",
            borderRadius: 4,
            border: `1.5px solid ${mode === "add" ? "var(--accent)" : "var(--border)"}`,
            background: mode === "add" ? "var(--accent)" : "transparent",
            color: mode === "add" ? "var(--on-accent)" : "var(--ink-soft)",
            fontWeight: 600,
            fontSize: 13.5,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 5,
          }}
        >
          <Plus size={14} /> Add money
        </button>
        <button
          onClick={() => setMode("take")}
          style={{
            flex: 1,
            padding: "10px",
            borderRadius: 4,
            border: `1.5px solid ${mode === "take" ? "var(--danger)" : "var(--border)"}`,
            background: mode === "take" ? "var(--danger)" : "transparent",
            color: mode === "take" ? "var(--on-accent)" : "var(--ink-soft)",
            fontWeight: 600,
            fontSize: 13.5,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            gap: 5,
          }}
        >
          <Minus size={14} /> Take out
        </button>
      </div>
      <Field label="How much?">
        <input autoFocus type="number" inputMode="decimal" value={amount} onChange={(e) => setAmount(e.target.value)} placeholder="0.00" style={inputStyle} />
      </Field>
      <ModalActions onCancel={onCancel} onSave={save} disabled={!Number(amount)} />
    </Modal>
  );
}

// ---------------------------------------------------------------------------
// Shared bits: forms, modal, buttons
// ---------------------------------------------------------------------------

const inputStyle = {
  width: "100%",
  padding: "12px",
  borderRadius: 4,
  border: "1px solid var(--border)",
  background: "var(--input-bg)",
  fontSize: 16,
  color: "var(--ink)",
};

function Field({ label, children }) {
  return (
    <label style={{ display: "block", marginBottom: 14 }}>
      <div style={{ fontSize: 12, fontWeight: 600, color: "var(--ink-soft)", marginBottom: 6, textTransform: "uppercase", letterSpacing: 0.5 }}>{label}</div>
      {children}
    </label>
  );
}

function Toggle({ checked, onChange, label, hint }) {
  return (
    <button
      type="button"
      onClick={() => onChange(!checked)}
      aria-pressed={checked}
      style={{
        display: "flex",
        alignItems: "flex-start",
        gap: 12,
        background: "var(--input-bg)",
        border: "1px solid var(--border)",
        borderRadius: 4,
        padding: "12px",
        width: "100%",
        textAlign: "left",
        marginBottom: 16,
      }}
    >
      <span
        style={{
          width: 40,
          height: 24,
          borderRadius: 12,
          background: checked ? "var(--accent)" : "var(--border-dashed)",
          position: "relative",
          flexShrink: 0,
          marginTop: 1,
          transition: "background 0.15s ease",
        }}
      >
        <span
          style={{
            position: "absolute",
            top: 2,
            left: checked ? 18 : 2,
            width: 20,
            height: 20,
            borderRadius: "50%",
            background: "var(--card)",
            transition: "left 0.15s ease",
            boxShadow: "0 1px 2px rgba(0,0,0,0.2)",
          }}
        />
      </span>
      <span>
        <div style={{ fontSize: 14, fontWeight: 600, color: "var(--ink)" }}>{label}</div>
        {hint && <div style={{ fontSize: 12, color: "var(--ink-soft)", marginTop: 2, lineHeight: 1.4 }}>{hint}</div>}
      </span>
    </button>
  );
}

function AddButton({ onClick, label }) {
  return (
    <button
      onClick={onClick}
      style={{
        width: "100%",
        marginTop: 14,
        padding: "14px",
        borderRadius: 4,
        border: "1px dashed var(--border-dashed)",
        background: "transparent",
        color: "var(--accent)",
        fontWeight: 600,
        fontSize: 14.5,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        gap: 6,
      }}
    >
      <Plus size={17} /> {label}
    </button>
  );
}

function Modal({ title, onClose, children }) {
  return (
    <div
      style={{ position: "fixed", inset: 0, background: "rgba(31,41,51,0.4)", display: "flex", alignItems: "flex-end", justifyContent: "center", zIndex: 40 }}
      onClick={onClose}
    >
      <div
        onClick={(e) => e.stopPropagation()}
        style={{
          background: "var(--card)",
          width: "100%",
          maxWidth: 480,
          borderRadius: "10px 10px 0 0",
          padding: "20px 18px calc(20px + env(safe-area-inset-bottom, 0px))",
          boxShadow: "0 -8px 30px rgba(0,0,0,0.2)",
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
          <div style={{ fontFamily: "'Fraunces', serif", fontSize: 17, fontWeight: 600 }}>{title}</div>
          <button onClick={onClose} style={{ background: "none", border: "none", color: "var(--muted)", padding: 4 }}>
            <X size={18} />
          </button>
        </div>
        {children}
      </div>
    </div>
  );
}

function ModalActions({ onCancel, onSave, disabled }) {
  return (
    <div style={{ display: "flex", gap: 10, marginTop: 6 }}>
      <button onClick={onCancel} style={{ flex: 1, padding: "13px", borderRadius: 4, border: "1px solid var(--border)", background: "transparent", color: "var(--ink-soft)", fontWeight: 600, fontSize: 14.5 }}>
        Cancel
      </button>
      <button
        onClick={onSave}
        disabled={disabled}
        style={{ flex: 1, padding: "13px", borderRadius: 4, border: "none", background: disabled ? "var(--disabled)" : "var(--accent)", color: "var(--on-accent)", fontWeight: 600, fontSize: 14.5 }}
      >
        Save
      </button>
    </div>
  );
}


const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<App />);
</script>

