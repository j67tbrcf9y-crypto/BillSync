function BillForm({ initial, onCancel, onSave }) {
  const isNew = !initial.id;
  const [name, setName] = useState(initial.name || "");
  const [amount, setAmount] = useState(initial.amount ?? "");
  const [category, setCategory] = useState(initial.category || CATEGORIES[0]);
  const [dueDay, setDueDay] = useState(initial.dueDay ?? 1);
  const [recurring, setRecurring] = useState(!!initial.recurring);

  const save = () => {
    if (!name.trim() || !amount) return;
    onSave({
      id: initial.id || uid(),
      name: name.trim(),
      amount: Number(amount),
      category,
      dueDay: Number(dueDay),
      status: initial.status || "due",
      recurring,
      lastCycleKey: initial.lastCycleKey || CURRENT_CYCLE_KEY,
    });
  };

  return (
    <Modal title={isNew ? "Add money out" : "Edit money out"} onClose={onCancel}>
      <Field label="What is it?">
        <input autoFocus value={name} onChange={(e) => setName(e.target.value)} placeholder="Phone bill, Spotify, new shoes…" style={inputStyle} />
      </Field>
      <Field label="How much?">
        <input type="number" inputMode="decimal" value={amount} onChange={(e) => setAmount(e.target.value)} placeholder="0.00" style={inputStyle} />
      </Field>
      <Field label="Category">
        <select value={category} onChange={(e) => setCategory(e.target.value)} style={inputStyle}>
          {CATEGORIES.map((c) => (
            <option key={c} value={c}>{c}</option>
          ))}
        </select>
      </Field>
      <Field label="Due day of month">
        <input type="number" min={1} max={31} value={dueDay} onChange={(e) => setDueDay(e.target.value)} style={inputStyle} />
      </Field>
      <Toggle
        checked={recurring}
        onChange={setRecurring}
        label="Repeats every month"
        hint="It'll be waiting for you next month — no need to add it again."
      />
      <ModalActions onCancel={onCancel} onSave={save} disabled={!name.trim() || !amount} />
    </Modal>
  );
}

