// ---------------------------------------------------------------------------
// Constants & helpers
// ---------------------------------------------------------------------------

const CATEGORIES = [
  "Phone",
  "Subscriptions",
  "Clothes",
  "Games",
  "Snacks & Eating Out",
  "Savings",
  "Gifts",
  "Other",
];

const FREQUENCIES = [
  { id: "monthly", label: "Monthly", toMonthly: (v) => v },
  { id: "weekly", label: "Weekly", toMonthly: (v) => (v * 52) / 12 },
  { id: "biweekly", label: "Every 2 weeks", toMonthly: (v) => (v * 26) / 12 },
  { id: "yearly", label: "Yearly", toMonthly: (v) => v / 12 },
];

const monthlyOf = (item) => {
  const freq = FREQUENCIES.find((f) => f.id === item.frequency) || FREQUENCIES[0];
  return freq.toMonthly(Number(item.amount) || 0);
};

const INCOME_STATUSES = [
  { id: "na", label: "N/A", short: "N/A", color: "var(--muted)", text: "var(--on-accent)" },
  { id: "pending", label: "Pending", short: "Pending", color: "var(--pending)", text: "var(--on-accent)" },
  { id: "cleared", label: "Cleared", short: "Cleared", color: "var(--accent)", text: "var(--on-accent)" },
];

const BILL_STATUSES = [
  { id: "due", label: "Due", short: "Due", color: "var(--due)", text: "var(--due-ink)" },
  { id: "pending", label: "Pending", short: "Pending", color: "var(--pending)", text: "var(--on-accent)" },
  { id: "paid", label: "Paid", short: "Paid", color: "var(--accent)", text: "var(--on-accent)" },
  { id: "na", label: "N/A", short: "N/A", color: "var(--muted)", text: "var(--on-accent)" },
];

const CATEGORY_COLOR = {
  Phone: "#2E6E8E",
  Subscriptions: "#6B4E9E",
  Clothes: "#B0673F",
  Games: "#3F7D5C",
  "Snacks & Eating Out": "#C97B2E",
  Savings: "#1B5E4F",
  Gifts: "#A8467E",
  Other: "#5A6570",
};

const money = (n) =>
  (n < 0 ? "-$" : "$") +
  Math.abs(n).toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

const uid = () => Math.random().toString(36).slice(2, 10);

const ordinal = (n) => {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
};

const STORAGE_KEY = "ledger-data-v1";
const THEME_KEY = "ledger-theme";

const TODAY = new Date();
const MONTH_NAME = TODAY.toLocaleString(undefined, { month: "long", year: "numeric" });
const TODAY_ISO = TODAY.toISOString().slice(0, 10);
const TODAY_DAY = TODAY.getDate();
const DAYS_IN_MONTH = new Date(TODAY.getFullYear(), TODAY.getMonth() + 1, 0).getDate();
const CURRENT_CYCLE_KEY = `${TODAY.getFullYear()}-${String(TODAY.getMonth() + 1).padStart(2, "0")}`;

function billPctPaid(bills) {
  const total = bills.reduce((s, b) => s + (Number(b.amount) || 0), 0);
  const paid = bills.filter((b) => b.status === "paid").reduce((s, b) => s + (Number(b.amount) || 0), 0);
  return total > 0 ? (paid / total) * 100 : 0;
}

// Turn raw stored JSON into a fully-shaped, current data object.
// Handles first-run, older saves (pre-status, pre-history), and the
// daily paid-percent checkpoint used for the month-over-month trend note.
// Entries marked "repeats every month" silently reset the first time the
// app is opened in a new calendar month, so they never need re-adding.
function hydrate(raw) {
  let income = (raw?.income || []).map((i) => ({
    ...i,
    status: i.status || "na",
    recurring: !!i.recurring,
    lastCycleKey: i.lastCycleKey || CURRENT_CYCLE_KEY,
  }));
  income = income.map((i) =>
    i.recurring && i.lastCycleKey !== CURRENT_CYCLE_KEY ? { ...i, status: "na", lastCycleKey: CURRENT_CYCLE_KEY } : i
  );

  let bills = (raw?.bills || []).map((b) => ({
    ...b,
    status: b.status || (b.paid ? "paid" : "due"),
    recurring: !!b.recurring,
    lastCycleKey: b.lastCycleKey || CURRENT_CYCLE_KEY,
  }));
  bills = bills.map((b) =>
    b.recurring && b.lastCycleKey !== CURRENT_CYCLE_KEY ? { ...b, status: "due", lastCycleKey: CURRENT_CYCLE_KEY } : b
  );

  let dailyLog = raw?.dailyLog || [];
  const loggedToday = dailyLog.length && dailyLog[dailyLog.length - 1].date === TODAY_ISO;
  if (!loggedToday) {
    dailyLog = [...dailyLog, { day: TODAY_DAY, date: TODAY_ISO, pct: Math.round(billPctPaid(bills) * 10) / 10 }];
  }

  const history = raw?.history || [];

  const goals = (raw?.goals || []).map((g) => ({
    ...g,
    target: Number(g.target) || 0,
    saved: Math.max(0, Number(g.saved) || 0),
  }));

  return { income, bills, dailyLog, history, goals };
}

// ---------------------------------------------------------------------------
// Root component
// ---------------------------------------------------------------------------

function App() {
  const [data, setData] = useState(null); // null = loading
  const [tab, setTab] = useState("overview");
  const [saveState, setSaveState] = useState("idle");
  const [toast, setToast] = useState(null);
  const [theme, setTheme] = useState("light");

  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const res = await window.storage.get(STORAGE_KEY, false);
        if (!cancelled) setData(hydrate(res ? JSON.parse(res.value) : null));
      } catch (e) {
        if (!cancelled) setData(hydrate(null));
      }
      try {
        const themeRes = await window.storage.get(THEME_KEY, false);
        if (!cancelled && themeRes && (themeRes.value === "dark" || themeRes.value === "light")) {
          setTheme(themeRes.value);
        }
      } catch (e) {
        // no saved preference yet
      }
    })();
    return () => {
      cancelled = true;
    };
  }, []);

  const toggleTheme = useCallback(() => {
    setTheme((t) => {
      const next = t === "light" ? "dark" : "light";
      window.storage.set(THEME_KEY, next, false).catch(() => {});
      return next;
    });
  }, []);

  // Keep the browser-chrome color in sync with the current theme.
  // (Viewport, manifest, and icons are already set in index.html's <head>.)
  useEffect(() => {
    let tag = document.querySelector('meta[name="theme-color"]');
    if (!tag) {
      tag = document.createElement("meta");
      tag.setAttribute("name", "theme-color");
      document.head.appendChild(tag);
    }
    tag.setAttribute("content", theme === "dark" ? "#14181A" : "#EDEFEA");
  }, [theme]);

  useEffect(() => {
    if (data === null) return;
    setSaveState("saving");
    const t = setTimeout(async () => {
      try {
        const result = await window.storage.set(STORAGE_KEY, JSON.stringify(data), false);
        setSaveState(result ? "saved" : "error");
      } catch (e) {
        setSaveState("error");
      }
    }, 250);
    return () => clearTimeout(t);
  }, [data]);

  const showToast = useCallback((msg) => {
    setToast(msg);
    setTimeout(() => setToast(null), 1800);
  }, []);

  // Archives the current cycle (money out, money in, and its daily paid-%
  // log) into history, then resets everything for the new month.
  const startNewMonth = useCallback(() => {
    setData((d) => {
      const pctPaid = billPctPaid(d.bills);
      const entry = {
        id: uid(),
        monthLabel: MONTH_NAME,
        archivedAt: new Date().toISOString(),
        bills: d.bills.map((b) => ({ ...b })),
        income: d.income.map((i) => ({ ...i })),
        dailyLog: d.dailyLog,
        summary: { pctPaid },
      };
      const history = [entry, ...d.history].slice(0, 12);
      return {
        income: d.income.map((i) => ({ ...i, status: "na", lastCycleKey: CURRENT_CYCLE_KEY })),
        bills: d.bills.map((b) => ({ ...b, status: "due", lastCycleKey: CURRENT_CYCLE_KEY })),
        dailyLog: [{ day: TODAY_DAY, date: TODAY_ISO, pct: 0 }],
        history,
        goals: d.goals,
      };
    });
    showToast(`Saved ${MONTH_NAME} — new month started`);
  }, [showToast]);

  if (data === null) {
    return (
      <Shell theme={theme}>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "center", height: "60vh", color: "var(--ink-soft)", fontFamily: "'IBM Plex Mono', monospace", fontSize: 13, letterSpacing: 0.4 }}>
          opening BillSync…
        </div>
      </Shell>
    );
  }

  const totals = computeTotals(data);

  return (
    <Shell theme={theme}>
      <TopBar saveState={saveState} theme={theme} onToggleTheme={toggleTheme} />
      <div style={{ padding: "0 16px 96px", maxWidth: 480, margin: "0 auto" }}>
        {tab === "overview" && <Overview data={data} totals={totals} setTab={setTab} />}
        {tab === "bills" && <BillsView data={data} setData={setData} showToast={showToast} onNewMonth={startNewMonth} />}
        {tab === "income" && <IncomeView data={data} setData={setData} showToast={showToast} onNewMonth={startNewMonth} />}
        {tab === "goals" && <GoalsView data={data} setData={setData} showToast={showToast} />}
      </div>
      <BottomNav tab={tab} setTab={setTab} />
      {toast && <Toast text={toast} />}
    </Shell>
  );
}

