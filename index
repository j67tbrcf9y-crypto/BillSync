function StatusControl({ statuses, value, onChange }) {
  const idx = Math.max(0, statuses.findIndex((s) => s.id === value));
  const current = statuses[idx] || statuses[0];
  const next = statuses[(idx + 1) % statuses.length];
  return (
    <button
      onClick={(e) => {
        e.stopPropagation();
        onChange(next.id);
      }}
      aria-label={`Status: ${current.label}. Tap to mark as ${next.label}.`}
      style={{
        padding: "6px 12px",
        borderRadius: 20,
        border: `1.3px solid ${current.color}`,
        background: current.color,
        color: current.text || "var(--on-accent)",
        fontSize: 11,
        fontFamily: "'IBM Plex Mono', monospace",
        fontWeight: 600,
        letterSpacing: 0.3,
        lineHeight: 1,
        whiteSpace: "nowrap",
        flexShrink: 0,
      }}
    >
      {current.short}
    </button>
  );
}

// Wraps a row: drag left to reveal a Delete action, tap it to confirm.
// Tapping the row while open just closes it again (no accidental deletes).
function SwipeRow({ children, onDelete }) {
  const [dragX, setDragX] = useState(0);
  const [dragging, setDragging] = useState(false);
  const startX = useRef(0);
  const startDragX = useRef(0);
  const MAX = 72;

  const onPointerDown = (e) => {
    setDragging(true);
    startX.current = e.clientX;
    startDragX.current = dragX;
  };
  const onPointerMove = (e) => {
    if (!dragging) return;
    const delta = e.clientX - startX.current;
    setDragX(Math.max(-MAX, Math.min(0, startDragX.current + delta)));
  };
  const endDrag = () => {
    setDragging(false);
    setDragX((x) => (x < -MAX * 0.45 ? -MAX : 0));
  };
  const onRowClick = (e) => {
    if (dragX !== 0) {
      e.stopPropagation();
      setDragX(0);
    }
  };

  return (
    <div style={{ position: "relative", overflow: "hidden", borderRadius: 3 }}>
      <div style={{ position: "absolute", inset: 0, display: "flex", justifyContent: "flex-end" }} aria-hidden={dragX === 0}>
        <button
          onClick={() => {
            onDelete();
            setDragX(0);
          }}
          aria-label="Delete"
          style={{
            width: MAX,
            background: "var(--danger)",
            border: "none",
            color: "var(--on-accent)",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            justifyContent: "center",
            gap: 2,
            fontSize: 9.5,
            fontFamily: "'IBM Plex Mono', monospace",
            fontWeight: 600,
          }}
        >
          <Trash2 size={15} />
          Delete
        </button>
      </div>
      <div
        onPointerDown={onPointerDown}
        onPointerMove={onPointerMove}
        onPointerUp={endDrag}
        onPointerCancel={endDrag}
        onClickCapture={onRowClick}
        style={{
          transform: `translateX(${dragX}px)`,
          transition: dragging ? "none" : "transform 0.2s ease",
          touchAction: "pan-y",
          position: "relative",
          WebkitUserSelect: "none",
          userSelect: "none",
          WebkitTouchCallout: "none",
        }}
      >
        {children}
      </div>
    </div>
  );
}

