      <div style={{ display: "flex", flexDirection: "column", gap: 8, marginTop: 14 }}>
        {bills.length === 0 && <EmptyNote>Nothing here yet. Add your phone bill, subscriptions, or anything else you're responsible for.</EmptyNote>}
