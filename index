// ---------------------------------------------------------------------------
// Calculations
// ---------------------------------------------------------------------------

function computeTotals(data) {
  const clearedIncome = data.income.filter((i) => i.status === "cleared");
  const monthlyIncome = clearedIncome.reduce((sum, i) => sum + monthlyOf(i), 0);
  const pendingIncome = data.income.filter((i) => i.status === "pending").reduce((sum, i) => sum + monthlyOf(i), 0);

  const totalBills = data.bills.reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
  const paidBills = data.bills.filter((b) => b.status === "paid").reduce((sum, b) => sum + (Number(b.amount) || 0), 0);
  const unpaidBills = totalBills - paidBills;
  const remaining = monthlyIncome - totalBills;

  return { monthlyIncome, pendingIncome, totalBills, paidBills, unpaidBills, remaining };
}

// Finds the closest day-of-month entry (<= today) in last month's daily log,
// so Overview can show "you'd paid X% by day N last month".
function getTrend(data) {
  if (!data.history || data.history.length === 0) return null;
  const last = data.history[0];
  if (!last.dailyLog || !last.dailyLog.length) return null;
  const candidates = last.dailyLog.filter((e) => e.day <= TODAY_DAY);
  if (!candidates.length) return null;
  const entry = candidates.reduce((a, b) => (b.day > a.day ? b : a));
  return { monthLabel: last.monthLabel, day: entry.day, pct: entry.pct };
}

