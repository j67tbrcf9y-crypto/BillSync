function BillsView({ data, setData, showToast, onNewMonth }) {
  const [form, setForm] = useState(null);

  const bills = [...data.bills].sort((a, b) => a.dueDay - b.dueDay);

  const upsert = (bill) => {
    setData((d) => {
      const exists = d.bills.some((b) => b.id === bill.id);
      const bills = exists ? d.bills.map((b) => (b.id === bill.id ? bill : b)) : [...d.bills, bill];
      return { ...d, bills };
    });
    setForm(null);
    showToast(bill.name ? `Saved "${bill.name}"` : "Saved");
  };

  const remove = (id) => {
    setData((d) => ({ ...d, bills: d.bills.filter((b) => b.id !== id) }));
    showToast("Removed");
  };

  const setStatus = (id, status) => {
    setData((d) => ({ ...d, bills: d.bills.map((b) => (b.id === id ? { ...b, status } : b)) }));
  };

  return (
    <div style={{ paddingTop: 18 }}>
